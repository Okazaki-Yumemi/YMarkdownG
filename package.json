{
  "name": "ymarkdowng",
  "version": "1.0.0",
  "description": "可自定义背景与排版的本地 Markdown 笔记编辑器",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html README.md"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@uiw/react-codemirror": "^4.25.12",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"

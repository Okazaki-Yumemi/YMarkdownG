{
  "name": "ymarkdowng",
  "version": "0.4.0",
  "description": "可自定义背景与排版的本地 Markdown 笔记编辑器",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tests/native-store.test.cjs && playwright test",
    "format": "prettier --write src tests scripts electron *.ts *.json index.html README.md",
    "dev:web": "vite",
    "start": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win portable nsis --x64 --publish never",
    "package:installer": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test:desktop": "node scripts/test-desktop.mjs",
    "package:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "test:pdf": "node scripts/test-pdf.mjs",
    "test:sync": "node scripts/test-sync.mjs",
    "test:libraries": "node scripts/test-libraries.mjs",
    "test:rich": "node scripts/test-rich.mjs",
    "test:images": "node scripts/test-images.mjs"
  },
  "keywords": [],
  "author": "Okazaki-Yumemi",
  "type": "module",
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@uiw/react-codemirror": "^4.25.12",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.cjs"
}
